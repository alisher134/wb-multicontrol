## Examples

### 1. Large screen owns everything

```tsx
// ❌ BAD
function ExchangeDetailsPage() {
  const [filters, setFilters] = useState(DEFAULT_FILTERS);
  const { data, isLoading, refetch } = useExchangeDetails(id);
  const cancelExchange = useCancelExchange();
  const visibleSteps = data?.timeline.filter(/* ... */).sort(/* ... */) ?? [];

  const handleCancel = async () => {
    await cancelExchange.mutateAsync(id);
    refetch();
  };

  return (
    <Box>
      {/* header, buyer card, product card, timeline, modals inline */}
    </Box>
  );
}

// ✅ GOOD
function ExchangeDetailsPage() {
  const exchangeDetails = useExchangeDetailsPage(id);

  return (
    <AsyncWrapper
      isLoading={exchangeDetails.isLoading}
      isError={exchangeDetails.isError}
      data={exchangeDetails.exchange}
      loaderSlot={<ExchangeDetailsSkeleton />}
      errorSlot={<ExchangeDetailsError onRetry={exchangeDetails.refetch} />}
    >
      {(exchange) => (
        <ExchangeDetailsContent
          exchange={exchange}
          onCancel={exchangeDetails.handleCancel}
        />
      )}
    </AsyncWrapper>
  );
}
```

### 2. Business logic hidden in JSX

```tsx
// ❌ BAD
function ExchangeTabs({ activeTab, exchanges }: Props) {
  return (
    <Tabs index={activeTab === 'to-ship' ? 0 : activeTab === 'completed' ? 1 : 2}>
      <Tab>{exchanges.filter((e) => e.status === 'to-ship').length} to ship</Tab>
    </Tabs>
  );
}

// ✅ GOOD
function ExchangeTabs({ activeTab, tabCounts }: Props) {
  const activeIndex = getExchangeTabIndex(activeTab);

  return (
    <Tabs index={activeIndex}>
      <Tab>{tabCounts.toShip}</Tab>
      <Tab>{tabCounts.completed}</Tab>
      <Tab>{tabCounts.cancelled}</Tab>
    </Tabs>
  );
}
```

### 3. Missing loading / empty / error states

```tsx
// ❌ BAD
function ExchangeList({ filters }: Props) {
  const { data } = useExchangeList(filters);
  return (
    <Stack>
      {data?.items.map((exchange) => (
        <ExchangeListItem key={exchange.id} exchange={exchange} />
      ))}
    </Stack>
  );
}

// ✅ GOOD
function ExchangeList({ filters }: Props) {
  const { data, isLoading, isError, error, refetch } = useExchangeList(filters);

  return (
    <AsyncWrapper
      isLoading={isLoading}
      isError={isError}
      data={data}
      loaderSlot={<ExchangeListSkeleton />}
      errorSlot={
        <ErrorAlert
          errorMessage={error?.message ?? t('exchange.list.error')}
        />
      }
    >
      {(list) => (
        <Show
          when={list.items.length > 0}
          fallback={<EmptyState title={t('exchange.list.empty')} />}
        >
          <Stack>
            {list.items.map((exchange) => (
              <ExchangeListItem key={exchange.id} exchange={exchange} />
            ))}
          </Stack>
        </Show>
      )}
    </AsyncWrapper>
  );
}
```

### 4. Dense nested ternary in small component

```tsx
// ❌ BAD
function ExchangeStatusBadge({ exchange }: Props) {
  return (
    <Badge
      colorScheme={
        exchange.isCancelled ? 'red' : exchange.isCompleted
          ? 'green'
          : exchange.isToShip ? 'blue' : 'gray'
      }
    >
      {exchange.isCancelled ? 'cancelled' : exchange.isCompleted ? 'completed' : 'pending'}
    </Badge>
  );
}

// ✅ GOOD
function ExchangeStatusBadge({ exchange }: Props) {
  const { t } = useTranslation();
  const appearance = getExchangeStatusAppearance(exchange);

  return (
    <Badge colorScheme={appearance.colorScheme}>
      {t(appearance.labelKey)}
    </Badge>
  );
}
```

### 5. Inline async handler with side effects in JSX

```tsx
// ❌ BAD
<Button
  onClick={async () => {
    setIsSubmitting(true);
    await rejectExchange.mutateAsync({ id, reason });
    onClose();
    toast.success('Rejected');
  }}
>
  Reject
</Button>

// ✅ GOOD
function RejectExchangeModal({ exchangeId, onClose }: Props) {
  const rejectExchange = useRejectExchange();

  const handleReject = async (reason: RejectReason) => {
    await rejectExchange.mutateAsync({ id: exchangeId, reason });
    onClose();
  };

  return (
    <Button isLoading={rejectExchange.isLoading} onClick={() => handleReject(selectedReason)}>
      {t('exchange.reject.confirm')}
    </Button>
  );
}
```
