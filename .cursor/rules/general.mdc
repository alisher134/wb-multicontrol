## Examples

### 1. Scope creep

```tsx
// ❌ BAD — user asked to fix a button label; agent refactors the whole page
function ExchangeDetailsPage() {
  const exchange = useExchangeDetails(); // new hook extracted from unrelated logic
  const timeline = useMemo(() => buildTimeline(exchange), [exchange]); // drive-by refactor
  // ...
}

// ✅ GOOD — only the requested label fix
function ExchangeDetailsHeader({ exchangeId }: Props) {
  const { t } = useTranslation();
  return <Heading>{t('exchange.details.title', { id: exchangeId })}</Heading>;
}
```

### 2. Incomplete delivery

```tsx
// ❌ BAD
function CancelExchangeModal({ onConfirm }: Props) {
  const handleConfirm = () => {
    // TODO: wire API call
    onConfirm();
  };
  return <Button onClick={handleConfirm}>Cancel</Button>;
}

// ✅ GOOD — finished behavior with error handling
function CancelExchangeModal({ exchangeId, onClose }: Props) {
  const { t } = useTranslation();
  const cancelExchange = useCancelExchange();

  const handleConfirm = async () => {
    await cancelExchange.mutateAsync(exchangeId);
    onClose();
  };

  return (
    <Button isLoading={cancelExchange.isLoading} onClick={handleConfirm}>
      {t('exchange.cancel.confirm')}
    </Button>
  );
}
```

### 3. Reinventing existing utilities

```tsx
// ❌ BAD — local debounce when shared hook exists
function ExchangeListFilters() {
  const [search, setSearch] = useState('');
  useEffect(() => {
    const timer = setTimeout(() => fetchExchanges(search), 300);
    return () => clearTimeout(timer);
  }, [search]);
}

// ✅ GOOD
import { useDebouncedSearchQuery } from '@/shared/hooks/use-debounce';

function ExchangeListFilters() {
  const debouncedSearch = useDebouncedSearchQuery(search, resetPage);
}
```

### 4. Ignoring neighboring patterns

```tsx
// ❌ BAD — introduces Formik in a module that uses React Hook Form
import { Formik, Form } from 'formik';

function RejectExchangeForm() {
  return <Formik initialValues={{ reason: '' }} onSubmit={handleSubmit}>...</Formik>;
}

// ✅ GOOD — matches the exchange module's existing form approach
import { useForm } from 'react-hook-form';

function RejectExchangeForm() {
  const form = useForm<RejectExchangeFormValues>({ defaultValues: { reason: '' } });
}
```

### 5. Skipping verification

```
# ❌ BAD — agent reports "done" without running checks
Changed exchange-details-header.tsx. Ready for review.

# ✅ GOOD — agent runs and reports checks
Changed exchange-details-header.tsx.
- npm run lint — passed
- npm run format — applied
- npm run build — passed
- npx vitest run src/modules/exchange — passed
```
